{
    "manifest_version": 3,
    "name": "Wingman para Meet",
    "version": "0.2.0",
    "description": "Wingman, de sixth-sense: tu copiloto silencioso en Google Meet. Lee los subtítulos solo en tu navegador, sin bots en la llamada.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "tabCapture",
        "activeTab"
    ],
    "host_permissions": [
        "https://meet.google.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://meet.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Wingman",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    }
}

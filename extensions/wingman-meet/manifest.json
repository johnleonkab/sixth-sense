{
    "manifest_version": 3,
    "name": "Wingman para Meet",
    "version": "0.1.0",
    "description": "Wingman de sixth-sense: detecta tus llamadas de Meet y le pasa a sixth-sense lo que se dice, solo desde tu navegador.",
    "permissions": ["storage", "tabCapture", "activeTab"],
    "host_permissions": ["https://meet.google.com/*"],
    "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://meet.google.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Wingman"
    }
}

{
    "manifest_version": 3,
    "name": "Wingman para Meet (spike)",
    "version": "0.0.1",
    "description": "Spike H0 de Wingman: detecta la llamada de Meet y lee sus subtítulos, solo en tu navegador, para medir si bastan.",
    "permissions": ["storage", "tabCapture", "activeTab"],
    "host_permissions": ["https://meet.google.com/*"],
    "content_scripts": [
        {
            "matches": ["https://meet.google.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Wingman"
    }
}

                        "type": "string"
                    }
                },
                "start_date": {
                    "type": "string"
                },
                "end_date": {
                    "type": "string"
                }
            },
            "required": [
                "property",
                "metrics"
            ]
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": []
                    }
                }
            }
        },
        "annotations": {
            "readOnlyHint": true
        }
    },
    {
        "name": "alerts",
        "description": "Avisos como filas, los más recientes primero. status: pending (por defecto, los que esperan respuesta), all, addressed (resueltos o descartados) o routine (sin importancia). Para listarlos: ItemList con n, ref, headline, context, when, proposal, closed y pending (highlight).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "all",
                        "pending",
                        "addressed",
                        "routine"
                    ]
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "gmail",
                        "slack",
                        "calendar"
                    ]
                },
                "days": {
                    "type": "number",
                    "description": "Solo los de los últimos N días (como mucho 90)."
                },
                "limit": {
                    "type": "number",
                    "description": "Cuántos, como mucho 500."
                }
            }
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "n": {
                                "type": "number"
                            },
                            "ref": {
                                "type": "string"
                            },
                            "source": {
                                "type": "string"
                            },
                            "actor": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "why": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string"
                            },
                            "received": {
                                "type": "string"
                            },
                            "headline": {
                                "type": "string"
                            },
                            "context": {
                                "type": "string"
                            },
                            "when": {
                                "type": "string"
                            },
                            "proposal": {
                                "type": "string"
                            },
                            "closed": {
                                "type": "string"
                            },
                            "pending": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "annotations": {
            "readOnlyHint": true
        }
    },
    {
        "name": "calendar_events",
        "description": "Eventos del calendario como filas (title, day, weekday, start, minutes, calendar, organizer, attendees, mine, declined, all_day), de from a to (YYYY-MM-DD, como mucho 62 días). Para horas por día: @ByDay(rows, \"day\", \"minutes\") y divide entre 60.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "string",
                    "description": "Primer día, YYYY-MM-DD."
                },
                "to": {
                    "type": "string",
                    "description": "Último día, YYYY-MM-DD."
                },
                "title": {
                    "type": "string",
                    "description": "Solo los que tengan esto en el título."
                },
                "attendee": {
                    "type": "string",
                    "description": "Solo aquellos en los que está esta persona."
                }
            },
            "required": [
                "from",
                "to"
            ]
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "title": {
                                "type": "string"
                            },
                            "day": {
                                "type": "string"
                            },
                            "weekday": {
                                "type": "string"
                            },
                            "start": {
                                "type": "string"
                            },
                            "minutes": {
                                "type": "number"
                            },
                            "calendar": {
                                "type": "string"
                            },
                            "organizer": {
                                "type": "string"
                            },
                            "attendees": {
                                "type": "number"
                            },
                            "mine": {
                                "type": "boolean"
                            },
                            "declined": {
                                "type": "boolean"
                            },
                            "all_day": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "annotations": {
            "readOnlyHint": true
        }
    },
    {

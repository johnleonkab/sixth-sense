[
    {
        "name": "jira_issues",
        "description": "Issues de Jira como filas (key, summary, type, status, status_category, priority, assignee, updated). Con jql, los de esa consulta; con text, los que lo mencionan en los proyectos de las reglas.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "jql": {
                    "type": "string",
                    "description": "Consulta JQL."
                },
                "text": {
                    "type": "string",
                    "description": "Texto a buscar."
                },
                "limit": {
                    "type": "number",
                    "description": "Como mucho 100."
                }
            }
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "key": {
                                "type": "string"
                            },
                            "summary": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string"
                            },
                            "status_category": {
                                "type": "string"
                            },
                            "priority": {
                                "type": "string"
                            },
                            "assignee": {
                                "type": "string"
                            },
                            "updated": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "annotations": {
            "readOnlyHint": true
        }
    },
    {
        "name": "analytics_rows",
        "description": "Un informe de Google Analytics 4 como filas: un campo por dimensión y por métrica (mismos nombres que analytics_report). property por nombre, cuenta o id.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "property": {
                    "type": "string"
                },
                "metrics": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "dimensions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "start_date": {
                    "type": "string"
                },
                "end_date": {
                    "type": "string"
                }
            },
            "required": [
                "property",
                "metrics"
            ]
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": []
                    }
                }
            }
        },
        "annotations": {
            "readOnlyHint": true
        }
    },
    {
        "name": "alerts",
        "description": "Avisos como filas, los más recientes primero. status: pending (por defecto, los que esperan respuesta), all, addressed (resueltos o descartados) o routine (sin importancia). Para listarlos: ItemList con n, ref, headline, context, when, proposal, closed y pending (highlight).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "all",
                        "pending",
                        "addressed",
                        "routine"
                    ]
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "gmail",
                        "slack",
                        "calendar"
                    ]
                },
                "days": {
                    "type": "number",
                    "description": "Solo los de los últimos N días (como mucho 90)."
                },
                "limit": {
                    "type": "number",
                    "description": "Cuántos, como mucho 500."
                }
            }
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "n": {
                                "type": "number"
                            },
                            "ref": {
                                "type": "string"
                            },
                            "source": {
                                "type": "string"
                            },
                            "actor": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "why": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string"
                            },
                            "received": {
                                "type": "string"
                            },
                            "headline": {
                                "type": "string"
                            },
                            "context": {
                                "type": "string"
                            },
                            "when": {
                                "type": "string"
                            },
                            "proposal": {
                                "type": "string"
                            },
                            "closed": {
                                "type": "string"
                            },
                            "pending": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "annotations": {
            "readOnlyHint": true
        }
    }
]
